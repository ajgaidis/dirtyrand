 #define	CHK(x)	if ((x) == -1) { perror("x"); exit(1); }
 
+/*
+ * Cap the region we map.  lmbench sizes $FILE from physical RAM (MB=10901
+ * here => a 10.6GiB file), which (a) overflowed the old 32-bit state->size
+ * and tripped the "too small" test below, and (b) would not stay resident
+ * in the page cache -- we want to time the fault path, not the disk.
+ * Must be applied identically in main() and initialize(): benchmp() forks,
+ * so initialize() runs in a child and main() cannot see what it computes.
+ */
+#define	MAX_PAGEFAULT_BYTES	((size_t)1 << 30)	/* 1GiB */
+
+static size_t
+bench_size(off_t filesize)
+{
+	size_t	pagesize = (size_t)getpagesize();
+	size_t	sz = (size_t)filesize;
+
+	if (sz > MAX_PAGEFAULT_BYTES) sz = MAX_PAGEFAULT_BYTES;
+	sz -= sz % pagesize;
+	return (sz);
+}

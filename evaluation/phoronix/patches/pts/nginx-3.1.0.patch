--- a/nginx
+++ b/nginx
@@ -1,3 +1,18 @@
 #!/bin/sh
-./wrk-4.2.0/wrk -t $NUM_CPU_CORES $@ > $LOG_FILE 2>&1
+# wrk requires connections >= threads, but the profile always passes
+# -t $NUM_CPU_CORES. Clamp threads to the -c value so the low-connection
+# menu entries (e.g. "Connections: 1") can run on multi-core hosts.
+THREADS=$NUM_CPU_CORES
+CONNS=""
+PREV=""
+for ARG in $@; do
+	if [ "$PREV" = "-c" ]; then
+		CONNS=$ARG
+	fi
+	PREV=$ARG
+done
+if [ -n "$CONNS" ] && [ "$CONNS" -lt "$THREADS" ]; then
+	THREADS=$CONNS
+fi
+./wrk-4.2.0/wrk -t $THREADS $@ > $LOG_FILE 2>&1
 echo $? > ~/test-exit-status

diff --git a/arch/x86/include/asm/rnguard_mpk.h b/arch/x86/include/asm/rnguard_mpk.h
new file mode 100644
index 0000000..4db50f1
--- /dev/null
+++ b/arch/x86/include/asm/rnguard_mpk.h
@@ -0,0 +1,152 @@
+#ifndef _ASM_X86_RNGUARD_MPK_H
+#define _ASM_X86_RNGUARD_MPK_H
+
+#include <linux/compiler_attributes.h>
+#include <linux/percpu-defs.h>
+#include <linux/preempt.h>
+#include <asm/asm.h>
+#include <asm/irq_stack.h>
+#include <asm/pgtable_types.h>
+#include <asm/pkru.h>
+#include <asm/uaccess.h>
+
+/* The global pkey value that we use for isolated .rnguard_iso pages */
+#define PKEY_VAL	1U
+
+/* Macros that translate the pkey value into PTE entries */
+#define PKEY_PTE(pkey)	(((pkey) & 0xfUL) << _PAGE_BIT_PKEY_BIT0)
+#define _PAGE_ISO_PKEY	(PKEY_PTE(PKEY_VAL))
+
+/* Masks for setting/clearing PKRU */
+#define PKRU_MASK(pkey)	\
+	(u32)((PKRU_AD_BIT | PKRU_WD_BIT) << (PKRU_BITS_PER_PKEY * (pkey)))
+
+#ifdef CONFIG_RNGUARD_MPK
+
+#define RNGUARD_STACK_SIZE		PAGE_SIZE
+
+struct rnguard_stack {
+	u8 guard[PAGE_SIZE];
+	u8 stack[RNGUARD_STACK_SIZE];
+} __aligned(PAGE_SIZE);
+DECLARE_PER_CPU_RNGUARD_ISO(struct rnguard_stack, rnguard_stack);
+
+static __always_inline bool on_rnguard_stack(void)
+{
+	unsigned long sp = current_stack_pointer;
+	unsigned long lo = (unsigned long)raw_cpu_ptr(&rnguard_stack)->stack;
+
+	return sp >= lo && sp < lo + RNGUARD_STACK_SIZE;
+}
+
+#ifdef CONFIG_RNGUARD_MPK_SELFTEST
+#define rnguard_st_record_on_stack(var)  WRITE_ONCE((var), on_rnguard_stack())
+#else
+#define rnguard_st_record_on_stack(var)  do { } while (0)
+#endif
+
+/* Variable used for the stack unwinder to read pointer with gate closed */
+DECLARE_PER_CPU(unsigned long, rnguard_stack_caller_sp);
+
+/*
+ * Same as call_on_stack(), but captures the callee's return value from RAX.
+ */
+#define rnguard_call_on_stack_ret(ret, stack, func, asm_call, argconstr...)      \
+{																																							\
+	register void *tos asm("r11");																							\
+																																							\
+  tos = ((void *)(stack));																										\
+																																							\
+	asm_inline volatile(																												\
+		"movq   %%rsp, (%[tos])                         \n"												\
+    "movq   %[tos], %%rsp                           \n"             					\
+                                                                    					\
+    asm_call                                                        					\
+                                                                    					\
+    "popq   %%rsp                                   \n"             					\
+																																							\
+    : "+r" (tos), "=a" (ret), ASM_CALL_CONSTRAINT															\
+    : [__func] "i" (func), [tos] "r" (tos) argconstr													\
+		: "cc", "rcx", "rdx", "rsi", "rdi", "r8", "r9", "r10",  "memory"					\
+	);																																					\
+}
+
+/*
+ * Switch RSP to this CPU's isolated pseudo-stack for the duration of func.
+ * Note that the isolation gate must already be open and interrupts must
+ * be disabled!
+ */
+#define rnguard_run_on_stack(func, asm_call, constr, c_args...)				\
+{																																		\
+	if (on_rnguard_stack()) {																						\
+		func(c_args);																										\
+	} else {																													\
+		__this_cpu_write(rnguard_stack_caller_sp, current_stack_pointer);	\
+		call_on_stack((unsigned long)this_cpu_ptr(&rnguard_stack)->stack		\
+									+ RNGUARD_STACK_SIZE - 8, func, asm_call, constr);		\
+	}																																	\
+}
+
+#define rnguard_run_on_stack_ret(ret, func, asm_call, constr, c_args...)				\
+{																																						\
+	if (on_rnguard_stack()) {																										\
+		ret = func(c_args);																											\
+	} else {																																	\
+		__this_cpu_write(rnguard_stack_caller_sp, current_stack_pointer);					\
+		rnguard_call_on_stack_ret(ret,																							\
+													 (unsigned long)this_cpu_ptr(&rnguard_stack)->stack	\
+														+ RNGUARD_STACK_SIZE - 8, func, asm_call, constr);	\
+	}																																					\
+}
+
+#define RNGUARD_1ARG_CONSTRAINTS(a)					\
+      , [arg1] "r" ((unsigned long)(a))
+#define RNGUARD_2ARG_CONSTRAINTS(a, b)				\
+      , [arg1] "r" ((unsigned long)(a)),	\
+        [arg2] "r" ((unsigned long)(b))
+#define RNGUARD_3ARG_CONSTRAINTS(a, b, c)		\
+      , [arg1] "r" ((unsigned long)(a)),	\
+        [arg2] "r" ((unsigned long)(b)),	\
+        [arg3] "r" ((unsigned long)(c))
+
+#endif /* CONFIG_RNGUARD_MPK */
+
+#ifdef CONFIG_RNGUARD_MPK_SELFTEST
+extern bool rnguard_st_grb_on_stack;
+extern bool rnguard_st_gru_on_stack;
+#endif
+
+/*
+ * Open/close the pkey gate. NOT nesting safe by design. Every caller must
+ * hold interrupts off across the whole window, and no window may be entered
+ * from inside another on the same CPU.
+ */
+static __always_inline inline void enable_rnguard_iso_access(void)
+{
+	if (!cpu_feature_enabled(X86_FEATURE_OSPKE))
+		return;
+
+#ifdef CONFIG_RNGUARD_MPK_SELFTEST
+	WARN_ONCE(!(read_pkru() & PKRU_MASK(PKEY_VAL)),
+			"RNGUARD: gate already open on entry (nesting?)\n");
+#endif
+
+	wrpkru(rdpkru() & ~PKRU_MASK(PKEY_VAL));
+	__uaccess_begin();
+}
+
+static __always_inline void disable_rnguard_iso_access(void)
+{
+	if (!cpu_feature_enabled(X86_FEATURE_OSPKE))
+		return;
+
+#ifdef CONFIG_RNGUARD_MPK_SELFTEST
+	WARN_ONCE(read_pkru() & PKRU_MASK(PKEY_VAL),
+			"RNGUARD: gate already closed on eexit (unbalanced?)\n");
+#endif
+
+	wrpkru(rdpkru() | PKRU_MASK(PKEY_VAL));
+	__uaccess_end();
+}
+
+#endif /*_ASM_X86_RNGUARD_MPK_H */
diff --git a/arch/x86/include/asm/stacktrace.h b/arch/x86/include/asm/stacktrace.h
index 3881b53..c31e279 100644
--- a/arch/x86/include/asm/stacktrace.h
+++ b/arch/x86/include/asm/stacktrace.h
@@ -21,6 +21,9 @@ enum stack_type {
 	STACK_TYPE_ENTRY,
 	STACK_TYPE_EXCEPTION,
 	STACK_TYPE_EXCEPTION_LAST = STACK_TYPE_EXCEPTION + N_EXCEPTION_STACKS-1,
+#ifdef CONFIG_RNGUARD_MPK
+	STACK_TYPE_RNGUARD
+#endif
 };
 
 struct stack_info {
diff --git a/arch/x86/kernel/dumpstack_64.c b/arch/x86/kernel/dumpstack_64.c
index f05339f..3ac956c 100644
--- a/arch/x86/kernel/dumpstack_64.c
+++ b/arch/x86/kernel/dumpstack_64.c
@@ -19,6 +19,10 @@
 #include <asm/cpu_entry_area.h>
 #include <asm/stacktrace.h>
 
+#ifdef CONFIG_RNGUARD_MPK
+#include <asm/rnguard_mpk.h>
+#endif
+
 static const char * const exception_stack_names[] = {
 		[ ESTACK_DF	]	= "#DF",
 		[ ESTACK_NMI	]	= "NMI",
@@ -53,6 +57,11 @@ const char *stack_type_name(enum stack_type type)
 	if (type >= STACK_TYPE_EXCEPTION && type <= STACK_TYPE_EXCEPTION_LAST)
 		return exception_stack_names[type - STACK_TYPE_EXCEPTION];
 
+#ifdef CONFIG_RNGUARD_MPK
+	if (type == STACK_TYPE_RNGUARD)
+		return "RNGUARD";
+#endif
+
 	return NULL;
 }
 
@@ -132,6 +141,38 @@ static __always_inline bool in_exception_stack(unsigned long *stack, struct stac
 	return true;
 }
 
+#ifdef CONFIG_RNGUARD_MPK
+static __always_inline bool in_rnguard_stack(unsigned long *stack, struct stack_info *info)
+{
+	unsigned long *begin, *end;
+
+	begin = (unsigned long *)raw_cpu_ptr(&rnguard_stack)->stack;
+	end   = begin + RNGUARD_STACK_SIZE / sizeof(long);
+
+	if (stack < begin || stack >= end)
+		return false;
+
+	info->type = STACK_TYPE_RNGUARD;
+
+	/* Report an empty range to avoid #PFs */
+	info->begin = stack;
+	info->end   = stack;
+
+	/*
+	 * Saved RSP lives at the top of the pseudo-stack, which is protected, so
+	 * use the unprotected mirror.
+	 */
+	info->next_sp = (unsigned long *)raw_cpu_read(rnguard_stack_caller_sp);
+
+	return true;
+}
+#else /* !CONFIG_RNGUARD_MPK */
+static __always_inline bool in_rnguard_stack(unsigned long *stack, struct stack_info *info)
+{
+	return false;
+}
+#endif /* CONFIG_RNGUARD_MPK */
+
 static __always_inline bool in_irq_stack(unsigned long *stack, struct stack_info *info)
 {
 	unsigned long *end = (unsigned long *)this_cpu_read(pcpu_hot.hardirq_stack_ptr);
@@ -179,6 +220,11 @@ bool noinstr get_stack_info_noinstr(unsigned long *stack, struct task_struct *ta
 	if (in_exception_stack(stack, info))
 		return true;
 
+#ifdef CONFIG_RNGUARD_MPK
+	if (in_rnguard_stack(stack, info))
+		return true;
+#endif
+
 	if (in_irq_stack(stack, info))
 		return true;
 
diff --git a/arch/x86/kernel/vmlinux.lds.S b/arch/x86/kernel/vmlinux.lds.S
index feb8102..1921c19 100644
--- a/arch/x86/kernel/vmlinux.lds.S
+++ b/arch/x86/kernel/vmlinux.lds.S
@@ -189,6 +189,21 @@ SECTIONS
 		_edata = .;
 	} :data
 
+
+#ifdef CONFIG_RNGUARD_MPK
+		/*
+		 * New section for isolated pages for RNGUARD pkeys defense.
+	   * Put it in the data segment.
+	   */ 
+		. = ALIGN(PAGE_SIZE);
+		.rnguard_iso : AT(ADDR(.rnguard_iso) - LOAD_OFFSET) {
+			__rnguard_iso_start = .;
+			*(.rnguard_iso)
+			. = ALIGN(PAGE_SIZE);
+			__rnguard_iso_end = .;
+		} :data
+#endif /* CONFIG_RNGUARD_MPK */
+
 	BUG_TABLE
 
 	ORC_UNWIND_TABLE

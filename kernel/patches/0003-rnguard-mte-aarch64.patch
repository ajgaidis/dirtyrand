+#ifdef CONFIG_RNGUARD_MTE_SELFTEST
+
+static unsigned int rnguard_st_total;
+static unsigned int rnguard_st_pass;
+static unsigned int rnguard_st_fail;
+
+#define RNGUARD_ST(cond, fmt, ...)                                          \
+	do {                                                             \
+		rnguard_st_total++;                                         \
+		if (cond) {                                              \
+			rnguard_st_pass++;                                  \
+			pr_info("  [+] PASS: " fmt "\n", ##__VA_ARGS__); \
+		} else {                                                 \
+			rnguard_st_fail++;                                  \
+			pr_err("  [!] FAIL: " fmt "\n", ##__VA_ARGS__);  \
+		}                                                        \
+	} while (0)
+
+/*
+ * These emit an exception-table entry, so a tag check fault returns false
+ * instead of dying.
+ */
+static bool rnguard_probe_read(const void *addr, u64 *out)
+{
+	__get_kernel_nofault(out, addr, u64, fault);
+	return true;
+fault:
+	return false;
+}
+
+static bool rnguard_probe_write(void *addr, u64 val)
+{
+	__put_kernel_nofault(addr, &val, u64, fault);
+	return true;
+fault:
+	return false;
+}
+
+void rnguard_selftest_preconditions(void)
+{
+	u64 sctlr = read_sysreg(sctlr_el1);
+	u64 tcr = read_sysreg(tcr_el1);
+	u64 tcf = FIELD_GET(SCTLR_EL1_TCF_MASK, sctlr);
+
+	pr_info("Running RNGUARD MTE precondition self-tests (CPU#%d)\n",
+		smp_processor_id());
+
+	/* Ensure MTE is available */
+	RNGUARD_ST(system_supports_mte(), "CPU supports MTE");
+	RNGUARD_ST(sctlr & SCTLR_ELx_ATA,
+		"SCTLR_EL1.ATA = 1 (tag access enabled)");
+
+	/* TCF = 0 means no kernel tag check ever faults and our tags are useless */
+	RNGUARD_ST(tcf == SCTLR_EL1_TCF_SYNC,
+		"SCTLR_EL1.TCF = SYNC (is %llu: 0=off 1=sync 2=async 3=asymm)",
+		tcf);
+
+	/* Ensure we have the top byte ignore set */
+	RNGUARD_ST(tcr & TCR_TBI1,
+		"TCR_EL1.TBI1 = 1 (tagged kernel pointers translate)");
+
+	/*
+	 * TCMA1 exempts tag 0b0000 and 0b1111 pointers from checking. Thus, we
+	 * want TCMA1 off so an attacker can't just set a 0xF tag and bypass things.
+	 */
+	RNGUARD_ST(!(tcr & TCR_TCMA1),
+		"TCR_EL1.TCMA1 = 0 (tag 0x0/0xF pointers are NOT exempt)");
+	RNGUARD_ST(!IS_ENABLED(CONFIG_KASAN_HW_TAGS),
+		"CONFIG_KASAN_HW_TAGS=n (it sets TCMA1)");
+
+	/* Confirm linear map isn't taggable (i.e., MT_NORMAL_TAGGED) by default */
+	RNGUARD_ST(!rnguard_addr_is_mte_tagged((unsigned long)lm_alias(_text)),
+		"linear map is not MT_NORMAL_TAGGED");
+}
+
+void rnguard_selftest_region(const char *what, const void *tagged, size_t size)
+{
+	const void *untagged = (const void *)__untagged_addr((u64)tagged);
+	void *wrongtag = rnguard_tag_set(tagged, RNGUARD_TAG ^ 1);
+	unsigned int granules = 0, bad = 0;
+	unsigned long addr;
+	u64 saved, scratch;
+
+	pr_info("Self-testing region '%s' at %px (%zu bytes)\n", what, tagged,
+		size);
+
+	/* Check that the tagged pointer is tagged correctly */
+	RNGUARD_ST(rnguard_tag_get(tagged) == RNGUARD_TAG, "%s: pointer tag is %u", what,
+		RNGUARD_TAG);
+
+	/*
+	 * STG needs granule alignment; a misaligned base silently leaves the
+	 * leading granule untagged
+	 */
+	RNGUARD_ST(IS_ALIGNED((u64)tagged, MTE_GRANULE_SIZE),
+		"%s: base is MTE_GRANULE_SIZE aligned", what);
+
+	/* Tag checks happen only on MT_NORMAL_TAGGED mappings. */
+	RNGUARD_ST(rnguard_addr_is_mte_tagged((unsigned long)untagged),
+		"%s: page is MT_NORMAL_TAGGED", what);
+
+	/*
+	 * Catches mte_sync_tags() having zeroed the page after we tagged it:
+	 * set_pte_at() -> __set_ptes() clears tags on first tagging
+	 */
+	for (addr = (unsigned long)tagged; addr < (unsigned long)tagged + size;
+	     addr += MTE_GRANULE_SIZE) {
+		granules++;
+		if (rnguard_mte_get_mem_tag((void *)addr) != RNGUARD_TAG)
+			bad++;
+	}
+	RNGUARD_ST(!bad, "%s: all %u granule(s) tagged %u (%u bad)", what,
+		granules, RNGUARD_TAG, bad);
+
+	/*
+	 * The granule just past the region must not carry RNGUARD_TAG: proves we
+	 * tagged the object and not the whole page.
+	 */
+	RNGUARD_ST(rnguard_mte_get_mem_tag((void *)((unsigned long)tagged + size)) !=
+			RNGUARD_TAG,
+		"%s: granule past the region is not tagged %u", what, RNGUARD_TAG);
+
+	/*
+	 * Read first so every write below can put back the value it found.
+	 * This is live RNG state; a "successful" write must not corrupt it.
+	 */
+	RNGUARD_ST(rnguard_probe_read(tagged, &saved),
+		"%s: read via tagged pointer succeeds", what);
+	RNGUARD_ST(rnguard_probe_write((void *)tagged, saved),
+		"%s: write via tagged pointer succeeds", what);
+
+	/*
+	 * An ordinary kernel pointer to the same address, which is
+	 * what an arbitrary-write primitive holds, must fault.
+	 */
+	RNGUARD_ST(!rnguard_probe_read(untagged, &scratch),
+		"%s: read via untagged pointer %px FAULTS", what, untagged);
+	RNGUARD_ST(!rnguard_probe_write((void *)untagged, saved),
+		"%s: write via untagged pointer FAULTS", what);
+
+	/* Proves tag matching, not merely tagged-vs-untagged. */
+	RNGUARD_ST(!rnguard_probe_write(wrongtag, saved),
+		"%s: write via wrong tag %u FAULTS", what, RNGUARD_TAG ^ 1);
+}
+
+/*
+ * Generic counted assertion, for checks whose logic has to live in the
+ * caller but whose result should still land in the pass/fail tally below.
+ */
+void rnguard_selftest_check(bool cond, const char *what, const char *msg)
+{
+	RNGUARD_ST(cond, "%s: %s", what, msg);
+}
+
+/*
+ * Not rnguard_selftest_region(): that probes the granule past the region, which
+ * here is a neighbouring per-CPU object rather than something we tagged.
+ */
+void rnguard_selftest_stack(void)
+{
+	struct rnguard_stack *ks = raw_cpu_ptr(&rnguard_stack);
+	unsigned long lo = (unsigned long)ks->stack;
+	void *tagged = rnguard_tag_set(ks->stack, RNGUARD_TAG);
+	unsigned int granules = 0, bad = 0;
+	unsigned long addr;
+	u64 scratch;
+
+	pr_info("Self-testing pseudo-stack at %px (%lu bytes)\n", tagged,
+		(unsigned long)RNGUARD_STACK_SIZE);
+
+	RNGUARD_ST(rnguard_addr_is_mte_tagged(lo),
+		"rnguard_stack: page is MT_NORMAL_TAGGED");
+	RNGUARD_ST(IS_ALIGNED(lo, MTE_GRANULE_SIZE),
+		"rnguard_stack: base is MTE_GRANULE_SIZE aligned");
+	RNGUARD_ST(IS_ALIGNED(lo + RNGUARD_STACK_SIZE, 16),
+		"rnguard_stack: top is 16-byte aligned (SP alignment check)");
+
+	for (addr = lo; addr < lo + RNGUARD_STACK_SIZE; addr += MTE_GRANULE_SIZE) {
+		granules++;
+		if (rnguard_mte_get_mem_tag((void *)addr) != RNGUARD_TAG)
+			bad++;
+	}
+	RNGUARD_ST(!bad, "rnguard_stack: all %u granule(s) tagged %u (%u bad)",
+		granules, RNGUARD_TAG, bad);
+
+	/*
+	 * Probes target the bottom of the stack, which is only reached on a deep
+	 * frame and holds nothing live at init time.
+	 */
+	RNGUARD_ST(rnguard_probe_write(tagged, 0),
+		"rnguard_stack: write via tagged pointer succeeds");
+	RNGUARD_ST(!rnguard_probe_write(ks->stack, 0),
+		"rnguard_stack: write via untagged pointer %px FAULTS", ks->stack);
+	RNGUARD_ST(!rnguard_probe_write(rnguard_tag_set(ks->stack, RNGUARD_TAG ^ 1), 0),
+		"rnguard_stack: write via wrong tag %u FAULTS", RNGUARD_TAG ^ 1);
+
+	/* Overflow bound: the guard must be gone in both aliases. */
+	RNGUARD_ST(!rnguard_probe_read(ks->guard, &scratch),
+		"rnguard_stack: guard page %px is unmapped", ks->guard);
+	RNGUARD_ST(!rnguard_probe_read(rnguard_tag_set(ks->guard, RNGUARD_TAG), &scratch),
+		"rnguard_stack: guard page is unmapped for a tagged pointer too");
+}
+
+/*
+ * Tags are worthless if kernel tag checking gets turned off behind our back,
+ * and every other test would still pass. Report it, then put it back.
+ */
+void rnguard_selftest_tcf_tripwire(void)
+{
+	static atomic_t reports = ATOMIC_INIT(0);
+	u64 sctlr = read_sysreg(sctlr_el1);
+	int n;
+
+	if (likely(FIELD_GET(SCTLR_EL1_TCF_MASK, sctlr) == SCTLR_EL1_TCF_SYNC))
+		return;
+
+	n = atomic_inc_return(&reports);
+	if (n <= 3) {
+		pr_warn("CPU%d: SCTLR_EL1.TCF was cleared (sctlr=0x%016llx), repairing\n",
+			raw_smp_processor_id(), sctlr);
+		if (n == 1)
+			dump_stack();
+	}
+
+	sysreg_clear_set(sctlr_el1, SCTLR_EL1_TCF_MASK,
+			 SYS_FIELD_PREP(SCTLR_EL1, TCF, SCTLR_EL1_TCF_SYNC));
+	isb();
+}
+
+static DEFINE_PER_CPU(u64, rnguard_st_sctlr);
+
+static void rnguard_st_read_sctlr(void *unused)
+{
+	__this_cpu_write(rnguard_st_sctlr, read_sysreg(sctlr_el1));
+}
+
+/* Kernel tag checking must still be enabled on every CPU. */
+void rnguard_selftest_tcf(void)
+{
+	int cpu;
+
+	on_each_cpu(rnguard_st_read_sctlr, NULL, 1);
+
+	for_each_online_cpu(cpu) {
+		u64 tcf = FIELD_GET(SCTLR_EL1_TCF_MASK,
+				    per_cpu(rnguard_st_sctlr, cpu));
+
+		RNGUARD_ST(tcf == SCTLR_EL1_TCF_SYNC,
+			"CPU#%d: kernel tag checking still enabled (TCF=%llu)",
+			cpu, tcf);
+	}
+}
+
+void rnguard_selftest_summary(void)
+{
+	if (!rnguard_st_total)
+		pr_warn("RNGUARD MTE self-tests: none ran\n");
+	else if (rnguard_st_fail)
+		pr_err("RNGUARD MTE self-tests: %u PASSED, %u FAILED (%u TOTAL)\n",
+		       rnguard_st_pass, rnguard_st_fail, rnguard_st_total);
+	else

+			SYS_FIELD_PREP(SCTLR_EL1, TCF, SCTLR_EL1_TCF_SYNC));
+	isb();
+#endif
+
 	local_flush_tlb_all();
 }
 
diff --git a/arch/arm64/kernel/rnguard-stack.S b/arch/arm64/kernel/rnguard-stack.S
new file mode 100644
index 0000000..6350f78
--- /dev/null
+++ b/arch/arm64/kernel/rnguard-stack.S
@@ -0,0 +1,46 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * RNGuard: pivot sp onto this CPU's isolated, MTE-tagged pseudo-stack.
+ */
+
+#include <linux/linkage.h>
+
+/*
+ * unsigned long rnguard_call_on_stack(unsigned long tos, void *func,
+ *				    unsigned long arg0, unsigned long arg1);
+ *
+ *  x0 - top of the pseudo-stack, tagged RNGUARD_TAG, 16-byte aligned
+ *  x1 - function to run on it
+ *  x2 - first argument to func
+ *  x3 - second argument to func
+ *
+ * Returns whatever func returned: x0 is not touched on the way out.
+ *
+ * Interrupts must be disabled at entry. An exception taken while sp is on the
+ * pseudo-stack would push its pt_regs onto the pseudo-stack, run the whole
+ * handler in 4 KiB, and most likely walk into the guard page.
+ */
+SYM_FUNC_START(rnguard_call_on_stack)
+	mov	x9, sp			/* remember the caller's stack */
+	mov	sp, x0			/* pivot; x0 carries RNGUARD_TAG */
+
+	/*
+	 * Frame record first, so the unwinder can walk out of the pseudo-stack
+	 * and back onto the caller's stack. This is a write-back store off sp,
+	 * i.e., a tag-checked access: the first instruction that requires sp's
+	 * tag to match the region's allocation tag.
+	 */
+	stp	x29, x30, [sp, #-16]!
+	mov	x29, sp
+	str	x9, [sp, #-16]!		/* caller's sp; keeps sp 16-byte aligned */
+
+	mov	x9, x1			/* func */
+	mov	x0, x2			/* arg0 */
+	mov	x1, x3			/* arg1 */
+	blr	x9
+
+	ldr	x9, [sp], #16
+	ldp	x29, x30, [sp], #16
+	mov	sp, x9			/* back onto the caller's stack */
+	ret
+SYM_FUNC_END(rnguard_call_on_stack)

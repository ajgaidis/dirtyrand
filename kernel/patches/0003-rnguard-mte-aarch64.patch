diff --git a/arch/arm64/mm/rnguard_mte.c b/arch/arm64/mm/rnguard_mte.c
new file mode 100644
index 0000000..3fbf3fa
--- /dev/null
+++ b/arch/arm64/mm/rnguard_mte.c
@@ -0,0 +1,595 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#define pr_fmt(fmt) "[RNGUARD]: " fmt
+
+#include <linux/kernel.h>
+#include <linux/pgtable.h>
+#include <linux/mm.h>
+#include <linux/percpu.h>
+#include <linux/set_memory.h>
+#include <asm/memory.h>
+#include <asm/mte-rnguard.h>
+#include <asm/set_memory.h>
+#include <asm/sysreg.h>
+#include <asm/tlbflush.h>
+
+bool rnguard_addr_is_mte_tagged(unsigned long addr)
+{
+	pgd_t *pgdp;
+	p4d_t *p4dp;
+	pud_t *pudp;
+	pmd_t *pmdp;
+	pte_t *ptep, pte;
+	pteval_t pteval;
+
+	/* Get the Page Global Directory (PGD) */
+	pgdp = pgd_offset_k(addr);
+	if (pgd_none(*pgdp) || pgd_bad(*pgdp)) {
+		pr_warn("[!] Problem getting PGD!\n");
+		return false;
+	}
+
+	/* Walk down to P4D */
+	p4dp = p4d_offset(pgdp, addr);
+	if (p4d_none(*p4dp) || p4d_bad(*p4dp)) {
+		pr_warn("[!] Problem getting P4D!\n");
+		return false;
+	}
+
+	/* Walk down to PUD */
+	pudp = pud_offset(p4dp, addr);
+	if (pud_none(*pudp) || pud_bad(*pudp)) {
+		pr_warn("[!] Problem getting PUD!\n");
+		return false;
+	}
+
+	/* Walk down to PMD (Page Middle Directory) */
+	pmdp = pmd_offset(pudp, addr);
+	if (pmd_none(*pmdp) || pmd_bad(*pmdp)) {
+		pr_warn("[!] Problem getting PMD!\n");
+		return false;
+	}
+
+	/* Get the Page Table Entry (PTE) */
+	ptep = pte_offset_kernel(pmdp, addr);
+	if (!ptep) {
+		pr_warn("[!] Problem getting PTE!\n");
+		return false;
+	}
+
+	pte = READ_ONCE(*ptep);
+	if (!pte_present(pte)) {
+		pr_warn("[!] Problem reading PTE pointer!\n");
+		return false;
+	}
+
+	/* Extract the raw PTE val */
+	pteval = pte_val(pte);
+
+	/* Is the PTE marked with MT_NORMAL_TAGGED? */
+	return ((pteval & PTE_ATTRINDX_MASK) == PTE_ATTRINDX(MT_NORMAL_TAGGED));
+}
+
+bool rnguard_set_page_mte_tagged(unsigned long addr)
+{
+	pgd_t *pgdp;
+	p4d_t *p4dp;
+	pud_t *pudp;
+	pmd_t *pmdp;
+	pte_t *ptep, pte;
+
+	/* Align the address to the start of the page */
+	addr &= PAGE_MASK;
+
+	/* Walk the page tables to find the specific PTE */
+	pgdp = pgd_offset_k(addr);
+	if (pgd_none(*pgdp) || pgd_bad(*pgdp))
+		return false;
+
+	p4dp = p4d_offset(pgdp, addr);
+	if (p4d_none(*p4dp) || p4d_bad(*p4dp))
+		return false;
+
+	pudp = pud_offset(p4dp, addr);
+	if (pud_none(*pudp) || pud_bad(*pudp))
+		return false;
+
+	pmdp = pmd_offset(pudp, addr);
+	if (pmd_none(*pmdp) || pmd_bad(*pmdp)) {
+		pr_warn("  [!] 0x%lx is block-mapped; no PTE to promote\n",
+			addr);
+		return false;
+	}
+
+	ptep = pte_offset_kernel(pmdp, addr);
+	if (!ptep)
+		return false;
+
+	pte = READ_ONCE(*ptep);
+	if (!pte_present(pte))
+		return false;
+
+	/* If it is already tagged, bail out to save CPU cycles */
+	if (pte_tagged(pte)) {
+		pr_info("Address %px is already MT_NORMAL_TAGGED\n",
+			(void *)addr);
+		return false;
+	}
+
+	/*
+	 * ARM64 Break-Before-Make (BBM) Sequence
+	 */
+
+	/* BREAK - Clear the current PTE */
+	pte_clear(&init_mm, addr, ptep);
+
+	/* FLUSH - Invalidate the TLB for this specific page */
+	flush_tlb_kernel_range(addr, addr + PAGE_SIZE);
+
+	/* Modify our local copy of the PTE to include the tagged attribute */
+	pte = pfn_pte(pte_pfn(pte), pgprot_tagged(pte_pgprot(pte)));
+
+	/* MAKE - Write the new, tagged PTE to the page table */
+	set_pte_at(&init_mm, addr, ptep, pte);
+
+	/* Ensure the write and CPU pipeline are synchronized before proceeding */
+	isb();
+
+	pr_info("Successfully upgraded page at %px to MT_NORMAL_TAGGED\n",
+		(void *)addr);
+
+	return true;
+}
+
+int rnguard_set_mte_tags(void **ptr, size_t mem_size)
+{
+	void *p = *ptr;
+	unsigned long start, end, addr;
+
+	start = (unsigned long)p & PAGE_MASK;
+	end = PAGE_ALIGN((unsigned long)p + mem_size);
+
+	if (!system_supports_mte()) {
+		pr_err("  [!] MTE unsupported; RNGuard isolation disabled\n");
+		return -EPERM;
+	}
+
+	/*
+	 * We loop here because something like base_crng is only 16-byte aligned
+	 * and can straddle a page boundary.
+	 */
+	for (addr = start; addr < end; addr += PAGE_SIZE) {
+		/*
+		 * Promotion zeroes every granule, so the rest of the page needs
+		 * the tag an ordinary kernel pointer carries. Only on promotion:
+		 * repainting an already-promoted page would wipe the RNGUARD_TAG of
+		 * everything tagged on it earlier.
+		 */
+		if (rnguard_set_page_mte_tagged(addr))
+			rnguard_mte_set_mem_tag_range((void *)addr, PAGE_SIZE,
+						   RNGUARD_NATIVE_TAG);
+	}
+
+	p = rnguard_tag_set(p, RNGUARD_TAG);
+	rnguard_mte_set_mem_tag_range(p, mem_size, RNGUARD_TAG);
+
+	pr_info("  [+] Tagged region: ptrtag=%u, memtag=%u, region size=%zu\n",
+		rnguard_tag_get(p), rnguard_mte_get_mem_tag(p), mem_size);
+
+	*ptr = p;
+	return 0;
+}
+
+DEFINE_PER_CPU_PAGE_ALIGNED(struct rnguard_stack, rnguard_stack);
+
+static int __init rnguard_install_guard_page(unsigned long addr)
+{
+	int ret;
+
+	/*
+	 * set_direct_map_invalid_noflush() silently does nothing on a
+	 * block-mapped linear map, which would leave the bound imaginary.
+	 */
+	if (!can_set_direct_map()) {
+		pr_err("  [!] Linear map is block-mapped; no guard page at 0x%lx\n",
+		       addr);
+		return -EOPNOTSUPP;
+	}
+
+	ret = set_direct_map_invalid_noflush(virt_to_page((void *)addr));
+	if (ret) {
+		pr_err("  [!] Failed to unmap guard page 0x%lx (%d)\n", addr,
+		       ret);
+		return ret;
+	}
+
+	flush_tlb_kernel_range(addr, addr + PAGE_SIZE);
+	pr_info("  [+] Guard page installed at 0x%lx\n", addr);
+
+	return 0;
+}
+
+/* Tag every CPU's pseudo-stack and unmap the guard page below it. */
+int __init rnguard_mte_init_stacks(void)
+{
+	int cpu, ret = 0;
+
+	for_each_online_cpu(cpu) {
+		struct rnguard_stack *ks = per_cpu_ptr(&rnguard_stack, cpu);
+		void *p = ks->stack;
+		int err;
+
+		err = rnguard_set_mte_tags(&p, RNGUARD_STACK_SIZE);
+		if (err)
+			ret = err;
+
+		err = rnguard_install_guard_page((unsigned long)ks->guard);
+		if (err)
+			ret = err;
+	}
+
+	return ret;
+}
+
+static void print_u64_bits_labeled(u64 val)
+{
+	/* Buffers for 64 characters + 1 null terminator */
+	char bit_str[65];
+	char tens_str[65];
+	char ones_str[65];
+	int i, pos = 0;
+
+	/* Loop from the most significant bit (63) down to the least (0) */
+	for (i = 63; i >= 0; i--) {
+		/* Extract the current bit */
+		bit_str[pos] = ((val >> i) & 1) ? '1' : '0';
+
+		/* Format the tens digit (leave blank if < 10 for cleaner look) */
+		tens_str[pos] = (i >= 10) ? ('0' + (i / 10)) : ' ';
+
+		/* Format the ones digit */
+		ones_str[pos] = '0' + (i % 10);
+
+		pos++;
+	}
+
+	/* Null-terminate the strings */
+	bit_str[64] = '\0';
+	tens_str[64] = '\0';
+	ones_str[64] = '\0';
+
+	/* Print them out */
+	pr_info("  Bits: %s\n", bit_str);
+	pr_info("  Idx : %s\n", tens_str);
+	pr_info("        %s\n", ones_str);
+}
+
+/* Shift and mask definitions for MTE control registers */
+#define SCTLR_EL1_ATA_BIT 43
+#define SCTLR_EL1_TCF_SHIFT 40
+
+#define TCR_TBI1_BIT 38
+#define TCR_TCMA1_BIT 58
+
+void dump_mte_registers(void)
+{
+	int i;
+
+	/* Read the system registers */
+	u64 sctlr = read_sysreg(sctlr_el1);
+	u64 tcr = read_sysreg(tcr_el1);
+	u64 mair = read_sysreg(mair_el1);
+
+	/* GCR_EL1 requires read_sysreg_s as the compiler lacks the named alias */
+	u64 gcr = read_sysreg_s(SYS_GCR_EL1);
+
+	pr_info("===== ARM64 MTE Register State =====\n");
+
+	pr_info("SCTLR_EL1 : 0x%016llx\n", sctlr);
+	print_u64_bits_labeled(sctlr);
+	pr_info(" - ATA (Bit 43)    : %llu (1 = Tag access enabled)\n",
+		(sctlr >> SCTLR_EL1_ATA_BIT) & 1);
+	pr_info(" - TCF (Bits 41:40): %llu (0=None, 1=Sync, 2=Async, 3=Asymm)\n",
+		(sctlr >> SCTLR_EL1_TCF_SHIFT) & 0x3ULL);
+
+	pr_info("TCR_EL1   : 0x%016llx\n", tcr);
+	print_u64_bits_labeled(tcr);
+	pr_info(" - TBI1 (Bit 38)   : %llu (1 = Top Byte Ignore enabled for TTBR1)\n",
+		(tcr >> TCR_TBI1_BIT) & 1);
+	pr_info(" - TCMA1 (Bit 58)  : %llu (1 = Tag Check Mask Override enabled)\n",
+		(tcr >> TCR_TCMA1_BIT) & 1);
+
+	pr_info("MAIR_EL1  : 0x%016llx\n", mair);
+	print_u64_bits_labeled(mair);
+	for (i = 0; i < 8; i++) {
+		u8 attr = (mair >> (i * 8)) & 0xFF;
+
+		pr_info(" - Attr%d : 0x%02x %s\n", i, attr,
+			(attr == 0xF0) ? "<-- Tagged Memory (MTE)!" : "");
+	}
+
+	/* Extract GCR-related fields */
+	u8 gcr_rrnd = (gcr >> 16) & 1;
+	u16 gcr_exclude = gcr & SYS_GCR_EL1_EXCL_MASK;
+
+	pr_info("GCR_EL1   : 0x%016llx\n", gcr);
+	print_u64_bits_labeled(gcr);
+	pr_info(" - RRND (Bit 16) : %u (1 = Random, 0 = Deterministic)\n",
+		gcr_rrnd);
+	pr_info(" - Exclude Mask  : 0x%04x\n", gcr_exclude);
+	if (gcr_exclude) {
+		pr_info("  - Excluded Tags : ");
+		for (i = 0; i < 16; i++) {
+			if (gcr_exclude & (1 << i))
+				pr_cont("%x ", i);
+		}
+		pr_cont("\n");
+	}
+
+	pr_info("====================================\n");
+}

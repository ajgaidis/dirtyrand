diff --git a/arch/arm64/include/asm/stacktrace.h b/arch/arm64/include/asm/stacktrace.h
index 66ec8ca..93e35b5 100644
--- a/arch/arm64/include/asm/stacktrace.h
+++ b/arch/arm64/include/asm/stacktrace.h
@@ -59,6 +59,25 @@ static inline bool on_task_stack(const struct task_struct *tsk,
 
 #define on_thread_stack()	(on_task_stack(current, current_stack_pointer, 1))
 
+#ifdef CONFIG_RNGUARD_MTE
+#include <asm/mte-rnguard.h>
+
+/*
+ * The RNG's pseudo-stack. Bounds are reported tagged, to match the fp values
+ * chained through it. Unlike in_rnguard_stack() on x86, the real bounds can be
+ * reported: the unwinder's reads go through those tagged pointers and pass.
+ */
+static inline struct stack_info stackinfo_get_rnguard(void)
+{
+	unsigned long low = rnguard_stack_top() - RNGUARD_STACK_SIZE;
+
+	return (struct stack_info) {
+		.low = low,
+		.high = low + RNGUARD_STACK_SIZE,
+	};
+}
+#endif /* CONFIG_RNGUARD_MTE */
+
 #ifdef CONFIG_VMAP_STACK
 DECLARE_PER_CPU(unsigned long [OVERFLOW_STACK_SIZE/sizeof(long)], overflow_stack);
 

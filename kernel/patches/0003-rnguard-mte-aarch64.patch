index 6174671..474ab4c 100644
--- a/arch/arm64/kernel/mte.c
+++ b/arch/arm64/kernel/mte.c
@@ -21,6 +21,9 @@
 #include <asm/barrier.h>
 #include <asm/cpufeature.h>
 #include <asm/mte.h>
+#ifdef CONFIG_RNGUARD_MTE
+#include <asm/mte-rnguard.h>
+#endif
 #include <asm/ptrace.h>
 #include <asm/sysreg.h>
 
@@ -252,6 +255,11 @@ void mte_thread_switch(struct task_struct *next)
 	/* TCO may not have been disabled on exception entry for the current task. */
 	mte_disable_tco_entry(next);
 
+#ifdef CONFIG_RNGUARD_MTE
+	/* Catch anything that turns kernel tag checking off behind our back. */
+	rnguard_selftest_tcf_tripwire();
+#endif
+
 	/*
 	 * Check if an async tag exception occurred at EL1.
 	 *
@@ -303,6 +311,16 @@ void mte_cpu_setup(void)
 	write_sysreg_s(0, SYS_TFSR_EL1);
 	write_sysreg_s(0, SYS_TFSRE0_EL1);
 
+#ifdef CONFIG_RNGUARD_MTE

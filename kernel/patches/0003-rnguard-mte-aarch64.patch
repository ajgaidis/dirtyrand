diff --git a/arch/arm64/mm/fault.c b/arch/arm64/mm/fault.c
index 8b281cf..fa46afe 100644
--- a/arch/arm64/mm/fault.c
+++ b/arch/arm64/mm/fault.c
@@ -343,6 +343,24 @@ static void do_tag_recovery(unsigned long addr, unsigned long esr,
 
 	report_tag_fault(addr, esr, regs);
 
+#ifdef CONFIG_RNGUARD_MTE
+	/*
+	 * Fail closed. Recovering as below would disable tag checking on this
+	 * CPU and then retry the access, so a single stray write to isolated
+	 * RNG state would switch the defense off and succeed---silently, since
+	 * report_tag_fault() is an empty stub without CONFIG_KASAN_HW_TAGS.
+	 *
+	 * fixup_exception() has already run, so *_kernel_nofault() probes such
+	 * as the RNGuard self-tests never reach here.
+	 */
+	bust_spinlocks(1);
+	pr_alert("[RNGUARD]: tag check fault on isolated RNG state at %016lx (pointer tag %lu)\n",
+		 addr, (addr & MTE_TAG_MASK) >> MTE_TAG_SHIFT);
+	mem_abort_decode(esr);
+	show_pte(addr);
+	show_regs(regs);
+	panic("RNGuard: MTE tag check fault at %016lx", addr);
+#else
 	/*
 	 * Disable MTE Tag Checking on the local CPU for the current EL.
 	 * It will be done lazily on the other CPUs when they will hit a
@@ -351,6 +369,7 @@ static void do_tag_recovery(unsigned long addr, unsigned long esr,
 	sysreg_clear_set(sctlr_el1, SCTLR_EL1_TCF_MASK,
 			 SYS_FIELD_PREP_ENUM(SCTLR_EL1, TCF, NONE));
 	isb();
+#endif /* CONFIG_RNGUARD_MTE */
 }
 
 static bool is_el1_mte_sync_tag_check_fault(unsigned long esr)
diff --git a/arch/arm64/mm/mmu.c b/arch/arm64/mm/mmu.c
index e55b02f..61ea571 100644
--- a/arch/arm64/mm/mmu.c
+++ b/arch/arm64/mm/mmu.c
@@ -665,8 +665,16 @@ static void __init map_mem(pgd_t *pgdp)
 		 * if MTE is present. Otherwise, it has the same attributes as
 		 * PAGE_KERNEL.
 		 */
-		__map_memblock(pgdp, start, end, pgprot_tagged(PAGE_KERNEL),
-			       flags);
+#ifndef CONFIG_RNGUARD_MTE
+		__map_memblock(pgdp, start, end, pgprot_tagged(PAGE_KERNEL), flags);
+#else
+		/*
+		 * Here we break userspace MTE protection. The trade-off is that now the
+		 * linear map doesn't have tagged pages by default; we promote only the
+		 * pages we actually protect in rnguard_set_page_mte_tagged().
+		 */
+		__map_memblock(pgdp, start, end, PAGE_KERNEL, flags);
+#endif
 	}
 

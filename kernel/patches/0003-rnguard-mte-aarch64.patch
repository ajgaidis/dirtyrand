diff --git a/arch/arm64/include/asm/mte-rnguard.h b/arch/arm64/include/asm/mte-rnguard.h
new file mode 100644
index 0000000..2c6aa58
--- /dev/null
+++ b/arch/arm64/include/asm/mte-rnguard.h
@@ -0,0 +1,229 @@
+#ifndef __ASM_MTE_RNGUARD_H
+#define __ASM_MTE_RNGUARD_H
+
+#ifdef CONFIG_RNGUARD_MTE
+
+#include <linux/percpu.h>
+#include <asm/cpufeature.h>
+#include <asm/mte-def.h>
+#include <asm/mte-kasan.h>
+#include <asm/page.h>
+#include <asm/stack_pointer.h>
+
+
+#define RNGUARD_TAG					0xC
+#define RNGUARD_NATIVE_TAG		0xF
+
+static inline void *rnguard_tag_set(const void *addr, u8 tag)
+{
+	return (void *)(((u64)addr & ~MTE_TAG_MASK) |
+									(((u64)tag << MTE_TAG_SHIFT) & MTE_TAG_MASK));
+}
+
+static inline u8 rnguard_tag_get(const void *addr)
+{
+  return (u8)(((u64)addr & MTE_TAG_MASK) >> MTE_TAG_SHIFT);
+}
+
+static inline u8 rnguard_mte_get_mem_tag(void *addr)
+{
+	if (!system_supports_mte())
+		return 0;
+
+	asm(__MTE_PREAMBLE "ldg %0, [%0]"
+		: "+r" (addr));
+
+	return rnguard_tag_get(addr);
+}
+
+static inline u8 rnguard_mte_get_random_tag(void)
+{
+	void *addr;
+
+	if (!system_supports_mte())
+		return 0;
+
+	asm(__MTE_PREAMBLE "irg %0, %0"
+		: "=r" (addr));
+
+	return rnguard_tag_get(addr);
+}
+
+static inline u64 __rnguard_stg_post(u64 p)
+{
+	asm volatile(__MTE_PREAMBLE "stg %0, [%0], #16"
+		     : "+r"(p)
+		     :
+		     : "memory");
+	return p;
+}
+
+static inline void __rnguard_dc_gva(u64 p)
+{
+	asm volatile(__MTE_PREAMBLE "dc gva, %0" : : "r"(p) : "memory");
+}
+
+/*
+ * Assign allocation tags for a region of memory based on the pointer tag.
+ * Note: The address must be non-NULL and MTE_GRANULE_SIZE aligned and
+ * size must be MTE_GRANULE_SIZE aligned.
+ */
+static inline void rnguard_mte_set_mem_tag_range(void *addr, size_t size, u8 tag)
+{
+	u64 curr, mask, dczid, dczid_bs, dczid_dzp, end1, end2, end3;
+
+	if (!system_supports_mte())
+		return;
+
+	/* Read DC G(Z)VA block size from the system register. */
+	dczid = read_cpuid(DCZID_EL0);
+	dczid_bs = 4ul << (dczid & 0xf);
+	dczid_dzp = (dczid >> 4) & 1;
+
+	curr = (u64)rnguard_tag_set(addr, tag);
+	mask = dczid_bs - 1;
+	/* STG/STZG up to the end of the first block. */
+	end1 = curr | mask;
+	end3 = curr + size;
+	/* DC GVA / GZVA in [end1, end2) */
+	end2 = end3 & ~mask;
+
+	/*
+	 * The following code uses STG on the first DC GVA block even if the
+	 * start address is aligned - it appears to be faster than an alignment
+	 * check + conditional branch. Also, if the range size is at least 2 DC
+	 * GVA blocks, the first two loops can use post-condition to save one
+	 * branch each.
+	 */
+	if (!dczid_dzp && size >= 2 * dczid_bs) {
+		do {
+			curr = __rnguard_stg_post(curr);
+		} while (curr < end1);
+
+		do {
+			__rnguard_dc_gva(curr);
+			curr += dczid_bs;
+		} while (curr < end2);
+	}
+
+	while (curr < end3)
+		curr = __rnguard_stg_post(curr);
+}
+
+bool rnguard_addr_is_mte_tagged(unsigned long addr);
+/* Returns true only if this call is what promoted the page. */
+bool rnguard_set_page_mte_tagged(unsigned long addr);
+int rnguard_set_mte_tags(void **ptr, size_t mem_size);
+void dump_mte_registers(void);
+
+#define RNGUARD_STACK_SIZE		PAGE_SIZE
+
+/* Per-CPU pseudo-stack for the RNG's transient state. */
+struct rnguard_stack {
+	u8 guard[PAGE_SIZE];
+	u8 stack[RNGUARD_STACK_SIZE];
+} __aligned(PAGE_SIZE);
+
+DECLARE_PER_CPU_PAGE_ALIGNED(struct rnguard_stack, rnguard_stack);
+
+/* Callers must have interrupts disabled: the region is per-CPU and shared. */
+static __always_inline unsigned long rnguard_stack_base(void)
+{
+	return (unsigned long)raw_cpu_ptr(&rnguard_stack)->stack;
+}
+
+/*
+ * Top of this CPU's pseudo-stack, tagged; sp is pivoted to this value. The tag
+ * is required, not cosmetic: AArch64 exempts sp-plus-immediate accesses from
+ * tag checking but not write-back forms or addresses materialised out of sp
+ * into a GPR, and those checks only pass if sp carries the tag.
+ */
+static __always_inline unsigned long rnguard_stack_top(void)
+{
+	return (unsigned long)rnguard_tag_set((void *)(rnguard_stack_base() +
+						    RNGUARD_STACK_SIZE),
+					   RNGUARD_TAG);
+}
+
+static __always_inline bool on_rnguard_stack(void)
+{
+	unsigned long sp = (unsigned long)__untagged_addr(current_stack_pointer);
+	unsigned long lo = rnguard_stack_base();
+
+	return sp >= lo && sp < lo + RNGUARD_STACK_SIZE;
+}
+
+/* Defined in arch/arm64/kernel/rnguard-stack.S */
+unsigned long rnguard_call_on_stack(unsigned long tos, void *func,
+				 unsigned long arg0, unsigned long arg1);
+
+/*
+ * Run func() on this CPU's pseudo-stack. Interrupts must already be disabled.
+ * The on_rnguard_stack() test mirrors call_on_irqstack_cond(): a nested call must
+ * not reset sp to the top and shred the outer frame.
+ *
+ * Split by arity because the nested case calls func() directly and so needs its
+ * real signature; x86 spells the same thing out with its ASM_CALL_ARGn tokens.
+ */
+#define rnguard_run_on_stack(func)							\
+{										\
+	if (on_rnguard_stack())							\
+		func();								\
+	else									\
+		rnguard_call_on_stack(rnguard_stack_top(), (void *)(func), 0, 0);	\
+}
+
+#define rnguard_run_on_stack_args(func, a0, a1)					\
+{										\
+	if (on_rnguard_stack())							\
+		func((a0), (a1));						\
+	else									\
+		rnguard_call_on_stack(rnguard_stack_top(), (void *)(func),		\
+				   (unsigned long)(a0), (unsigned long)(a1));	\
+}
+
+/* The cast matters: AAPCS64 leaves x0's upper bits unspecified for u8/u16/u32. */
+#define rnguard_run_on_stack_ret(ret, func)					\
+{										\
+	if (on_rnguard_stack())							\
+		(ret) = func();							\
+	else									\
+		(ret) = (typeof(ret))rnguard_call_on_stack(rnguard_stack_top(),	\
+							(void *)(func), 0, 0);	\
+}
+
+int rnguard_mte_init_stacks(void);
+
+#ifdef CONFIG_RNGUARD_MTE_SELFTEST
+/* Record whether an RNG body really executed on the pseudo-stack. */
+#define rnguard_st_record_on_stack(var)	WRITE_ONCE((var), on_rnguard_stack())
+
+void rnguard_selftest_preconditions(void);
+void rnguard_selftest_summary(void);
+void rnguard_selftest_region(const char *what, const void *tagged, size_t size);
+void rnguard_selftest_check(bool cond, const char *what, const char *msg);
+void rnguard_selftest_stack(void);
+void rnguard_selftest_tcf(void);
+
+/*
+ * Nothing should clear SCTLR_EL1.TCF once mte_cpu_setup() has set it: doing so
+ * turns every tag check into a no-op and disables the defense. Called from
+ * mte_thread_switch() to report and undo it if anything ever does.
+ */
+void rnguard_selftest_tcf_tripwire(void);
+#else /* !CONFIG_RNGUARD_MTE_SELFTEST */
+#define rnguard_st_record_on_stack(var)	do { } while (0)
+
+static inline void rnguard_selftest_preconditions(void) { }
+static inline void rnguard_selftest_summary(void) { }
+static inline void rnguard_selftest_region(const char *what,
+					const void *tagged, size_t size) { }
+static inline void rnguard_selftest_check(bool cond, const char *what,
+				       const char *msg) { }
+static inline void rnguard_selftest_stack(void) { }
+static inline void rnguard_selftest_tcf(void) { }
+static inline void rnguard_selftest_tcf_tripwire(void) { }
+#endif /* CONFIG_RNGUARD_MTE_SELFTEST */
+
+#endif /* CONFIG_RNGUARD_MTE */
+#endif /* __ASM_MTE_RNGUARD_H */

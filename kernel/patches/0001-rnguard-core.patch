+	enable_rnguard_iso_access();
+
+	rnguard_run_on_stack(__get_random_bytes, ASM_CALL_ARG2,
+										RNGUARD_2ARG_CONSTRAINTS(buf, len), buf, len);
+
+	disable_rnguard_iso_access();
+	local_irq_restore(flags);
+}
+
+#elif defined(CONFIG_RNGUARD_MTE)
+static void _get_random_bytes(void *buf, size_t len)

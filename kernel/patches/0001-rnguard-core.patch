+static int __init rnguard_mte_init(void)
+{
+	int cpu;
+	struct crng *crng_p;
+	struct batch_u8 *batch_u8_p;
+	struct batch_u16 *batch_u16_p;
+	struct batch_u32 *batch_u32_p;

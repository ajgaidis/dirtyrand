+#ifdef CONFIG_RNGUARD_MTE_SELFTEST
+/*
+ * Verify a region's granules still carry RNGUARD_TAG. rnguard_selftest_region() runs
+ * right after each region is tagged, so it cannot see a later tagging on the
+ * same page undoing an earlier one. This runs after all of them and can.
+ */
+static void __init rnguard_st_recheck(const char *what, const void *tagged,
+				   size_t size)
+{
+	unsigned long addr;
+	unsigned int bad = 0;
+
+	for (addr = (unsigned long)tagged;
+	     addr < (unsigned long)tagged + size;
+	     addr += MTE_GRANULE_SIZE)
+		if (rnguard_mte_get_mem_tag((void *)addr) != RNGUARD_TAG)
+			bad++;
+
+	rnguard_selftest_check(!bad, what, "tags intact");
+	if (bad)
+		pr_err("  [!] %s: %u granule(s) at %px no longer tagged %u\n",
+		       what, bad, tagged, RNGUARD_TAG);
+}
+
+#define rnguard_st_recheck_pcpu(obj, type, cpu)				\
+do {									\
+	char __name[32];						\
+									\
+	scnprintf(__name, sizeof(__name), #obj " CPU#%d", (cpu));	\
+	rnguard_st_recheck(__name,						\
+			rnguard_tag_set(per_cpu_ptr(&(obj), (cpu)), RNGUARD_TAG), \
+			sizeof(type));					\
+} while (0)

+		rnguard_st_recheck_pcpu(crngs, struct crng, cpu);
+		rnguard_st_recheck_pcpu(batched_entropy_u8, struct batch_u8, cpu);
+		rnguard_st_recheck_pcpu(batched_entropy_u16, struct batch_u16, cpu);
+		rnguard_st_recheck_pcpu(batched_entropy_u32, struct batch_u32, cpu);
+		rnguard_st_recheck_pcpu(batched_entropy_u64, struct batch_u64, cpu);
+
+		scnprintf(name, sizeof(name), "rnguard_stack CPU#%d", cpu);
+		rnguard_st_recheck(name,

+#define RNGUARD_USER_CHUNK_SIZE	512
+
+/*
+ * The upstream version keeps a live chacha_state across copy_to_iter() and
+ * cond_resched(), and neither the pkeys pseudo-stack nor the MTE per-CPU
+ * scratch may stay live across a fault or a reschedule. So each chunk is
+ * generated inside a protection window by _get_random_bytes(), and only the
+ * finished bytes cross the boundary.
+ *
+ * chunk[] is deliberately an ordinary stack array: it holds delivered
+ * randomness, which is out of scope in both designs (the caller's own buffer
+ * is unprotected the moment we return into it either way).
+ */
+static ssize_t get_random_bytes_user(struct iov_iter *iter)
+{
+	u8 chunk[RNGUARD_USER_CHUNK_SIZE];
+	size_t ret = 0, copied, len;
+
+	if (unlikely(!iov_iter_count(iter)))
+		return 0;
+
+	while (true) {
+		len = min_t(size_t, iov_iter_count(iter), sizeof(chunk));
+
+		_get_random_bytes(chunk, len);
+
+		copied = copy_to_iter(chunk, len, iter);
+		ret += copied;
+		if (!iov_iter_count(iter) || copied != len)
+			break;
+
+		if (signal_pending(current))
+			break;
+		cond_resched();
+	}
+
+	memzero_explicit(chunk, sizeof(chunk));
+	return ret ? ret : -EFAULT;
+}

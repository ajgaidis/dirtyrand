+	 * through a stored tagged pointer: rnguard_stack_top() re-derives the tag
+	 * on every entry, so only the memory needs tagging.
+	 */
+	if (rnguard_mte_init_stacks())
+		pr_err("  [!] Pseudo-stack setup incomplete\n");
